<Window x:Class="MarkEditWin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:MarkEditWin.Views"
        Title="MarkEdit"
        Width="1080"
        Height="740"
        MinWidth="520"
        MinHeight="360"
        Background="#FF1E1E1E"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu DockPanel.Dock="Top" x:Name="MainMenu" />

    <StatusBar DockPanel.Dock="Bottom" x:Name="Status" Height="24">
      <StatusBarItem>
        <TextBlock x:Name="StatusPath" Text="" Foreground="#FF555555" />
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="StatusReadOnly" Text="Read Only" Foreground="#FFB04000" Visibility="Collapsed" Margin="0,0,12,0" />
          <TextBlock x:Name="StatusPosition" Text="" Foreground="#FF555555" Margin="0,0,12,0" />
          <TextBlock x:Name="StatusLineEnding" Text="" Foreground="#FF555555" Margin="0,0,12,0" />
          <TextBlock x:Name="StatusEncoding" Text="" Foreground="#FF555555" Margin="0,0,12,0" />
        </StackPanel>
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <wv2:WebView2 x:Name="WebView" />
      <views:FindBar x:Name="FindBarControl"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Top"
                     Margin="0,14,26,0"
                     Visibility="Collapsed" />
    </Grid>
  </DockPanel>
</Window>

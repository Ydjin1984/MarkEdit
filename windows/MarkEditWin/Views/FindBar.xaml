<UserControl x:Class="MarkEditWin.Views.FindBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
  <Border Background="#FFF7F7F7"
          BorderBrush="#FFC8C8C8"
          BorderThickness="1"
          CornerRadius="6"
          Padding="10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" />
    </Border.Effect>

    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBox x:Name="SearchBox"
                 Width="240"
                 VerticalContentAlignment="Center"
                 Padding="6,4,6,4" />

        <TextBlock x:Name="CounterLabel"
                   Margin="8,0,8,0"
                   MinWidth="60"
                   VerticalAlignment="Center"
                   Foreground="#FF6A6A6A"
                   TextAlignment="Right" />

        <Button x:Name="PreviousButton" Content="↑" Width="28" ToolTip="Previous match (Shift+F3)" />
        <Button x:Name="NextButton" Content="↓" Width="28" Margin="4,0,0,0" ToolTip="Next match (F3)" />
        <ToggleButton x:Name="CaseButton" Content="Aa" Width="30" Margin="8,0,0,0" ToolTip="Match case" />
        <ToggleButton x:Name="WordButton" Content="ab" Width="30" Margin="4,0,0,0" ToolTip="Whole word" />
        <ToggleButton x:Name="RegexButton" Content=".*" Width="30" Margin="4,0,0,0" ToolTip="Regular expression" />
        <Button x:Name="CloseButton" Content="✕" Width="28" Margin="8,0,0,0" ToolTip="Close (Esc)" />
      </StackPanel>

      <StackPanel x:Name="ReplaceRow" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
        <TextBox x:Name="ReplaceBox"
                 Width="240"
                 VerticalContentAlignment="Center"
                 Padding="6,4,6,4" />

        <Button x:Name="ReplaceButton" Content="Replace" Margin="8,0,0,0" Padding="10,3,10,3" />
        <Button x:Name="ReplaceAllButton" Content="Replace All" Margin="6,0,0,0" Padding="10,3,10,3" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>

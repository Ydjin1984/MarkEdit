<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>MarkEdit</AssemblyName>
    <RootNamespace>MarkEditWin</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Version>1.36.0</Version>
    <FileVersion>1.36.0.0</FileVersion>
    <AssemblyVersion>1.36.0.0</AssemblyVersion>
    <Product>MarkEdit</Product>
    <AssemblyTitle>MarkEdit for Windows</AssemblyTitle>
    <Company>MarkEdit</Company>
    <Copyright>MIT License</Copyright>

    <!-- The editor core is a single self-contained HTML file produced by vite. -->
    <CoreEditorIndexHtml>$(MSBuildThisFileDirectory)..\..\CoreEditor\dist\index.html</CoreEditorIndexHtml>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(CoreEditorIndexHtml)"
                      LogicalName="MarkEditWin.Assets.index.html"
                      Condition="Exists('$(CoreEditorIndexHtml)')" />
    <EmbeddedResource Include="Assets\bridge-shim.js" LogicalName="MarkEditWin.Assets.bridge-shim.js" />
  </ItemGroup>

  <Target Name="EnsureCoreEditorBundle" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(CoreEditorIndexHtml)')"
           Text="CoreEditor bundle not found at $(CoreEditorIndexHtml). Run 'yarn build' in CoreEditor/ first (see windows/build.cmd)." />
  </Target>

</Project>
